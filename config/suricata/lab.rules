# Lab-tailored Suricata signatures for this project's own synthetic attack
# traffic. ET-Open's community rules target real-world threat signatures
# (known malware, real CVEs, real botnet C2) -- they were never going to
# recognize traffic this lab itself generates, and running Suricata against
# only that ruleset would be a strawman comparison, not a fair one. These
# rules encode the exact same shape knowledge this project's own
# detection/detector.py rule-based detectors already use (port, protocol,
# rate, payload size), so Suricata is judged on a fair, comparable signature
# version of that same knowledge -- not on whether it happens to recognize
# unrelated internet malware.
#
# Literal IPs, not $HOME_NET/$EXTERNAL_NET: this project's Mininet lab uses
# 10.0.0.0/24, and suricata.yaml's default address-group config (root-owned,
# not writable in this environment) targets a different range. Writing
# rules against the real lab IPs directly avoids depending on that config.
#
# sensor=10.0.0.10  attacker=10.0.0.100  decoy=10.0.0.200
#
# `type limit` is used for every threshold-based rule below, not
# `type threshold` (Suricata's own more commonly documented choice for
# "alert once N matches occur in a window") -- found via direct testing
# against this project's own real captured pcaps that `type threshold`
# never once emitted an alert for a UDP flow in this environment/Suricata
# version (7.0.3), even with a count far below what the traffic actually
# contained (10 required, 200+ available, 0 alerts). `type limit` was
# tested the same way and fired reliably and repeatedly. This is a real,
# disclosed Suricata behavior found while regenerating this project's own
# results, not assumed correct from documentation.

# reconnaissance_port_scan: many short TCP connection attempts to the
# sensor's known scan ports in a short window (simulation/traffic.py's
# generate_malicious_mininet_traffic hits 22, 80, 8080, 443 repeatedly).
alert tcp 10.0.0.100 any -> 10.0.0.10 [22,80,8080,443] (msg:"LAB reconnaissance port scan"; flags:S; threshold: type threshold, track by_src, count 8, seconds 5; sid:9000001; rev:1;)

# dos_flood: a tight-loop UDP burst to a single fixed port (port 5683).
# type limit, not type threshold -- see the file-level comment above.
alert udp 10.0.0.100 any -> 10.0.0.10 5683 (msg:"LAB DoS UDP flood"; threshold: type limit, track by_dst, count 20, seconds 2; sid:9000002; rev:1;)

# brute_force: repeated login attempts against the simulated management
# port (2222), each carrying the fixed "USER admin" probe payload.
alert tcp 10.0.0.100 any -> 10.0.0.10 2222 (msg:"LAB brute-force login attempt"; content:"USER admin"; sid:9000003; rev:1;)

# data_exfiltration: direction reversed from every other attack here -- the
# sensor is the source, sending unusually large UDP payloads (~1200 bytes)
# out to the attacker-controlled sink on port 4444.
alert udp 10.0.0.10 any -> 10.0.0.100 4444 (msg:"LAB data exfiltration to attacker sink"; dsize:>800; sid:9000004; rev:1;)

# exploit_payload_injection: a small number of oversized UDP requests
# (~400-byte payload) to the simulated management port (9200).
alert udp 10.0.0.100 any -> 10.0.0.10 9200 (msg:"LAB exploit payload injection"; dsize:>300; sid:9000005; rev:1;)

# tcp_syn_flood: many refused connects to a fixed port (6001) at a real,
# measured ~17.5 packets/sec (see traffic.py's own generator docstring).
# flags:S + a real live-verified working TCP type threshold (unlike UDP,
# TCP threshold tracking was directly confirmed to work in this
# environment via reconnaissance_port_scan's own rule above).
alert tcp 10.0.0.100 any -> 10.0.0.10 6001 (msg:"LAB tcp syn flood"; flags:S; threshold: type threshold, track by_src, count 20, seconds 3; sid:9000006; rev:1;)

# icmp_ping_flood: many padded ICMP echo requests to the sensor -- real
# captured traffic measured ~80 packets in under 6 real seconds, an order
# of magnitude past a real single ping exchange.
alert icmp 10.0.0.100 any -> 10.0.0.10 any (msg:"LAB icmp ping flood"; itype:8; threshold: type limit, track by_src, count 15, seconds 3; sid:9000007; rev:1;)

# slow_loris_exhaustion: many concurrent held-open connections to the
# sensor's simulated service port (7001), each from its own source port.
alert tcp 10.0.0.100 any -> 10.0.0.10 7001 (msg:"LAB slow loris exhaustion"; flags:S; threshold: type limit, track by_dst, count 15, seconds 5; sid:9000008; rev:1;)

# dns_amplification: oversized inbound UDP "reflected response" traffic on
# port 53 -- real captured payloads measured up to ~540 bytes average,
# well past a real DNS query/response's own typical size.
alert udp 10.0.0.100 any -> 10.0.0.10 53 (msg:"LAB dns amplification"; dsize:>400; sid:9000009; rev:1;)

# dns_tunneling_exfiltration: direction reversed like data_exfiltration --
# the sensor sends many small, frequent outbound UDP queries (real
# captured payload: a fixed "QQQQ" filler) to port 53, the opposite shape
# from dns_amplification's few, large, inbound ones.
alert udp 10.0.0.10 any -> 10.0.0.100 53 (msg:"LAB dns tunneling exfiltration"; threshold: type limit, track by_src, count 5, seconds 5; sid:9000010; rev:1;)

# mqtt_message_flood: many real completed TCP connections to the
# simulated broker port (1883), spread over a much longer real window
# (~78s) than this registry's faster floods.
alert tcp 10.0.0.100 any -> 10.0.0.10 1883 (msg:"LAB mqtt message flood"; flags:S; threshold: type limit, track by_src, count 10, seconds 10; sid:9000011; rev:1;)

# firmware_tampering: direction reversed -- the sensor pushes periodic
# oversized UDP payloads (real captured average ~520 bytes) out to the
# attacker-controlled sink on port 7443.
alert udp 10.0.0.10 any -> 10.0.0.100 7443 (msg:"LAB firmware tampering"; dsize:>400; sid:9000012; rev:1;)

# buffer_overflow_probe: a sustained campaign of oversized TCP payloads
# over one connection to the sensor's simulated service port (7100), real
# captured payloads measured up to ~700 bytes.
alert tcp 10.0.0.100 any -> 10.0.0.10 7100 (msg:"LAB buffer overflow probe"; dsize:>400; sid:9000013; rev:1;)

# credential_replay: repeated uniform UDP payload to port 6668 -- real
# captured traffic carries the fixed literal "TOKEN=stale-session-abc123"
# probe string, a genuine content match rather than a size/rate heuristic.
alert udp 10.0.0.100 any -> 10.0.0.10 6668 (msg:"LAB credential replay"; content:"TOKEN="; sid:9000014; rev:1;)

# rogue_config_beacon: direction reversed -- the sensor sends a frequent,
# small outbound UDP pattern to the attacker-controlled sink on port 7999,
# this registry's deliberately lowest-confidence signature.
alert udp 10.0.0.10 any -> 10.0.0.100 7999 (msg:"LAB rogue config beacon"; threshold: type limit, track by_src, count 5, seconds 5; sid:9000015; rev:1;)

# c2_beaconing: NOT direction-reversed (unlike the three attacks above) --
# regular UDP beacon traffic to the attacker-controlled port 8443. Its own
# real distinguishing signal is inter-packet timing regularity
# (inter_arrival_cv), which this project's own rule-based detector uses
# but a Suricata signature cannot easily express; port+protocol is used
# here instead, safe because port 8443 is unique to this one attack across
# the whole registry.
alert udp 10.0.0.100 any -> 10.0.0.10 8443 (msg:"LAB c2 beaconing"; threshold: type limit, track by_src, count 5, seconds 10; sid:9000016; rev:1;)
